# Copy to .env, fill in real values, then encrypt in place: dotenvx encrypt -f .env
# See README "Secrets" section.
# 9router Configuration
NINEROUTER_INITIAL_PASSWORD=change_this_to_a_secure_password
NINEROUTER_JWT_SECRET=change_this_to_a_random_jwt_secret_string

# Rendered from host Tailscale state by scripts/dotenv-env.sh; do not fill in or encrypt.
TAILSCALE_IP=

# hermes-webui (Hermex client) login password; also needs API_SERVER_KEY (>=16 chars, shared with the Hermes gateway).
HERMES_WEBUI_PASSWORD=change_this_to_a_strong_password
API_SERVER_KEY=

# Streamed Chromium (browser.williamwibowo.com) basic-auth password; user is `browser`.
BROWSER_PASSWORD=change_this_to_a_strong_password

# Headroom is internal-only; no proxy token or published port.

# Butler dashboard authentication.
BUTLER_LOGIN=you@example.com
# Rendered by scripts/dotenv-env.sh (the Caddy hostname); do not fill in or encrypt.
BUTLER_ORIGIN=https://butler.williamwibowo.com
BUTLER_WEB_ORIGIN=https://butler.williamwibowo.com
# Secret Google Calendar iCal URL; read-only but treat as a password. Reset in Google Calendar if exposed.
BUTLER_ICAL_URL=https://calendar.google.com/calendar/ical/<calendar-id>/private-<secret>/basic.ics
# BUTLER_9ROUTER_TOKEN=
# BUTLER_LIBRARIAN_TOKEN_SHA256=
# BUTLER_LLM_API_KEY=
# BUTLER_LLM_MODEL=sonnet_level
# Google OAuth (Web application client, personal GCP project). Secret: never commit.
BUTLER_GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
BUTLER_GOOGLE_CLIENT_SECRET=<secret>

# GHCR pull access for the private Butler images (docker login ghcr.io as ubuntu, done by the butler role).
# Classic PAT with ONLY read:packages (GHCR does not accept fine-grained tokens). Never reuse a repo-scoped token.
GHCR_USERNAME=…
GHCR_PULL_TOKEN=…

# Cloudflare API token for Caddy (DNS-01 certificates) and the Ansible dns role. Scope: Zone DNS Edit (+ Zone Read) on williamwibowo.com only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TERRAFORM_TOKEN=

# Public website. PUBLIC_IP: the VPS's public IPv4 (cloud console), read by Terraform for the proxied apex record.
# PUBLIC_BIND_IP: the address on the main NIC (`ip -4 -br addr show eth0`), where Caddy listens for the public site.
PUBLIC_IP=
PUBLIC_BIND_IP=

# Terraform R2 state backend (S3 API token scoped to the state bucket) and the Cloudflare account that owns it.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Lark bot for Hermes gateway (open.larksuite.com custom app). Set both via the Butler Secrets page.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
