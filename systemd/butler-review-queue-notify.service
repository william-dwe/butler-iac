[Unit]
Description=Telegram alert (via Hermes) that the Butler review queue run failed
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=NOTIFY_UNIT=butler-review-queue.service
Environment="NOTIFY_TITLE=Butler review queue"
Environment="NOTIFY_WHAT=The Butler review queue run failed. It runs every 5 min; the same error is re-sent at most hourly."
Environment=NOTIFY_STATE_NAME=butler-review-queue-notify
ExecStart=/home/ubuntu/services/butler-iac/scripts/gitops-pull-notify.sh
TimeoutStartSec=2min
NoNewPrivileges=yes
