[Unit]
# Template: %i = the Linux user to run as. e.g. hermes-dashboard@hermes / hermes-dashboard@ubuntu
Description=Hermes Agent dashboard (web + TUI) on :9119 as %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i
Environment=HOME=/home/%i LANG=en_US.UTF-8 TERM=xterm-256color
Environment=PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets live off-git; "-" = don't fail if the file is missing. Read by systemd as root, so 600 is fine.
EnvironmentFile=-/home/ubuntu/.config/butler-iac/runtime.env
# ponytail: --insecure + 0.0.0.0 relies on UFW (only tailscale0 + 22 allowed). Bind to the tailscale IP if UFW ever changes.
ExecStart=/home/%i/.local/bin/hermes dashboard --host 0.0.0.0 --port 9119 --insecure --tui --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
