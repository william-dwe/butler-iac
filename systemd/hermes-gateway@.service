[Unit]
# Template: %i = the Linux user to run as. e.g. hermes-gateway@hermes / hermes-gateway@ubuntu
Description=Hermes Agent gateway (default profile) as %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i
Environment=HOME=/home/%i LANG=en_US.UTF-8 TERM=xterm-256color
Environment=PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets live off-git; "-" = don't fail if the file is missing. Read by systemd as root, so 600 is fine.
EnvironmentFile=-/home/ubuntu/.config/butler-iac/runtime.env
ExecStart=/home/%i/.local/bin/hermes gateway run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
