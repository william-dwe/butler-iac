[Unit]
Description=Encrypted restic backup of agent state
OnFailure=backup-notify.service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/home/ubuntu/services/butler-iac/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
NoNewPrivileges=yes
