[Unit]
Description=GitOps: pull butler-iac manifests and apply with docker compose
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
# Pull first so a new .env is visible, then root (+ ignores User=/NoNewPrivileges) re-renders runtime.env/stack.env if .env changed.
ExecStartPre=/usr/bin/git -C /home/ubuntu/services/butler-iac pull --ff-only
ExecStartPre=+/home/ubuntu/services/butler-iac/scripts/gitops-env-sync.sh
ExecStart=/home/ubuntu/services/butler-iac/scripts/gitops-pull-apply.sh
TimeoutStartSec=30min
NoNewPrivileges=yes
