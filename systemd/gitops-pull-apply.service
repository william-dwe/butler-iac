[Unit]
Description=GitOps: pull butler-iac manifests and apply with docker compose
OnFailure=gitops-pull-notify.service
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
# Sync first (fast-forward, or rebase local .env commits onto origin, then push them) so a new .env is visible; then root (+ ignores
# User=/NoNewPrivileges) re-renders runtime.env/stack.env, reloads units and restarts env-set-api when their inputs changed.
ExecStartPre=/home/ubuntu/services/butler-iac/scripts/git-sync.sh --push-env
ExecStartPre=+/home/ubuntu/services/butler-iac/scripts/gitops-env-sync.sh
ExecStart=/home/ubuntu/services/butler-iac/scripts/gitops-pull-apply.sh
TimeoutStartSec=30min
NoNewPrivileges=yes
