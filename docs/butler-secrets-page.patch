+"use client";
+
+import { useEffect, useRef, useState, type FormEvent } from "react";
+import { announce } from "./announce";
+import { toast } from "./toast";
+import { Badge, input, label, primary } from "./ui";
+
+type Entry = { key: string; set: boolean };
+
+/**
+ * Write-only editor for the stack's dotenvx .env. Talks to /_env/* (Caddy routes it to the infra repo's
+ * scripts/env-set-api.py, never to the Butler backend). The value is never read back, stored, logged or kept in state.
+ */
+export function SecretsForm() {
+  const [entries, setEntries] = useState<Entry[] | null>(null);
+  const [loadError, setLoadError] = useState("");
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const submitting = useRef(false);
+  const valueRef = useRef<HTMLInputElement>(null);
+
+  async function load() {
+    try {
+      const r = await fetch("/_env/keys", { cache: "no-store" });
+      if (!r.ok) throw new Error(`HTTP ${r.status}`);
+      setEntries(await r.json());
+      setLoadError("");
+    } catch (err) {
+      setLoadError((err as Error).message);
+    }
+  }
+
+  useEffect(() => {
+    void load();
+  }, []);
+
+  async function submit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    if (submitting.current) return;
+    const form = e.currentTarget;
+    const data = new FormData(form);
+    const key = String(data.get("key") ?? "");
+    const value = String(data.get("value") ?? "");
+    if (!key) return fail("Choose a key.");
+    if (!value) return fail("Enter a value.");
+    submitting.current = true;
+    setBusy(true);
+    setError("");
+    try {
+      const r = await fetch("/_env/set", {
+        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ key, value }),
+      });
+      const b = await r.json().catch(() => ({}));
+      if (!r.ok) return fail(b.message ?? b.error ?? `HTTP ${r.status}`);
+      form.reset();
+      toast(`Saved ${key}`);
+      announce(`Saved ${key}`);
+      await load();
+    } catch (err) {
+      fail((err as Error).message);
+    } finally {
+      submitting.current = false;
+      setBusy(false);
+    }
+  }
+
+  function fail(msg: string) {
+    setError(msg);
+    announce(msg);
+    valueRef.current?.focus();
+  }
+
+  return (
+    <section aria-labelledby="secrets-h" className="mx-auto max-w-xl">
+      <h1 id="secrets-h" className="text-xl font-semibold tracking-tight">Secrets</h1>
+      <p className="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
+        Add or update a key in the encrypted .env. Values are write-only and never shown. Changes apply on the next
+        deploy run (about a minute). A new key must first be added to .env.example in the infra repo.
+      </p>
+
+      {loadError && <p role="alert" className="mt-4 text-sm text-rose-700 dark:text-rose-300">Could not load keys: {loadError}</p>}
+
+      <form onSubmit={submit} noValidate aria-label="Set secret" autoComplete="off"
+        className="mt-4 space-y-3 rounded-lg border border-zinc-200 bg-white p-4 shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
+        <div>
+          <label htmlFor="secret-key" className={label}>Key</label>
+          <select id="secret-key" name="key" defaultValue="" disabled={!entries} className={input}>
+            <option value="" disabled>{entries ? "Select a key" : "Loading…"}</option>
+            {entries?.map((e) => <option key={e.key} value={e.key}>{e.key}{e.set ? "" : " (not set)"}</option>)}
+          </select>
+        </div>
+        <div>
+          <label htmlFor="secret-value" className={label}>Value</label>
+          <input ref={valueRef} id="secret-value" name="value" type="password" autoComplete="new-password"
+            autoCapitalize="off" autoCorrect="off" spellCheck={false} maxLength={4096}
+            aria-invalid={error ? true : undefined} aria-describedby={error ? "secret-error" : undefined} className={input} />
+        </div>
+        {error && <p id="secret-error" role="alert" className="text-sm text-rose-700 dark:text-rose-300">{error}</p>}
+        <button type="submit" disabled={busy || !entries} className={primary}>{busy ? "Saving…" : "Save"}</button>
+      </form>
+
+      {entries && (
+        <ul aria-label="Keys" className="mt-4 divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white text-sm dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
+          {entries.map((e) => (
+            <li key={e.key} className="flex items-center justify-between gap-3 px-3 py-2">
+              <span className="break-all font-mono text-xs">{e.key}</span>
+              <Badge value={e.set ? "done" : "unset"} prefix="status" />
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
