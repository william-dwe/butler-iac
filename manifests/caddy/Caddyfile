# One block per service. Private = `import private` (bound to the Tailscale IP, so unreachable outside the tailnet).
# DNS: *.williamwibowo.com -> Tailscale IP; the apex and www are explicit proxied records (terraform/stacks/cloudflare).
{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	https_port {$CADDY_HTTPS_PORT}
	auto_https disable_redirects
}

(private) {
	bind {$TAILSCALE_IP}
}

grafana.williamwibowo.com {
	import private
	reverse_proxy 127.0.0.1:3000
}

hermes.williamwibowo.com {
	import private
	reverse_proxy {$TAILSCALE_IP}:9119
}

chat.williamwibowo.com {
	import private
	reverse_proxy 127.0.0.1:8787
}

router.williamwibowo.com {
	import private
	reverse_proxy {$TAILSCALE_IP}:20128
}

prom.williamwibowo.com {
	import private
	reverse_proxy 172.17.0.1:9090
}

paseo.williamwibowo.com {
	import private
	reverse_proxy 127.0.0.1:6767
}

# Butler has no login of its own: it trusts Tailscale-User-Login (== BUTLER_LOGIN). `header_up` REPLACES any client-supplied value,
# so identity is fixed here. Safe only while this site stays private and the tailnet has a single owner (reachable == you).
butler.williamwibowo.com {
	import private
	reverse_proxy 127.0.0.1:3100 {
		header_up Tailscale-User-Login {$BUTLER_LOGIN}
	}
}

# Public site. Not `import private`: it binds the host's NIC address (the cloud NAT forwards the public IP to it; a
# 0.0.0.0 bind would clash with the Tailscale-bound sites on :443). UFW lets only Cloudflare's ranges reach 443, and
# the apex/www records are proxied, so visitors never talk to this host directly.
williamwibowo.com {
	bind {$PUBLIC_BIND_IP}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3200
}

www.williamwibowo.com {
	bind {$PUBLIC_BIND_IP}
	redir https://williamwibowo.com{uri} permanent
}
