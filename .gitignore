# dotenvx private key material and plaintext environment variants.
# .env itself IS committed only when dotenvx-encrypted.
.env.*
!.env.example
*.key
*.pem

# Python bytecode cache
__pycache__/

# Persistent data (includes data/vault/, the Obsidian second-brain vault; never commit)
data/
.archive/

# Ansible vault password and state backups (backups hold plaintext secrets)
ansible/secret.txt
ansible/backups/

# OS / Editor files
.DS_Store
*.log
workspace/briefs/

# Terraform: providers and state never go in git (state lives in the R2 backend); the lock file does.
.terraform/
*.tfstate
*.tfstate.*
crash.log
*_override.tf
*.tfvars
!*.tfvars.example
